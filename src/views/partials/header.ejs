<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#2f8f6b">
  <meta name="description" content="Consulta veterinaria por videollamada cuando no podés llevar a tu mascota a la clínica.">
  <meta property="og:title" content="<%= appName %> · Consulta veterinaria por videollamada">
  <meta property="og:description" content="Reservá una teleconsulta con un veterinario y recibí pautas para tu mascota.">
  <meta property="og:type" content="website">
  <title><%= title %> · <%= appName %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css?v=<%= assetV %>">
  <script>document.documentElement.classList.add('js');</script>
</head>
<body>
  <header class="top">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">🐾</span>
      <%= appName %>
    </a>
    <nav>
      <% if (user && user.role === 'vet') { %>
        <a href="/vet">Mi panel</a>
        <a href="/vet/disponibilidad">Disponibilidad</a>
      <% } %>
      <% if (user && user.role === 'admin') { %>
        <a href="/admin">Veterinarios</a>
        <a href="/admin/turnos">Turnos</a>
      <% } %>
      <% if (user) { %>
        <form method="post" action="/logout" class="inline"><button class="link" type="submit">Salir</button></form>
      <% } else { %>
        <a href="/login">Ingresar</a>
      <% } %>
    </nav>
  </header>
  <main class="container">
