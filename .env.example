# Nombre que se muestra en la app (encabezado, pestaña y mails). Por defecto: Patitas
APP_NAME=Patitas

# URL pública de la app (sin barra final)
BASE_URL=https://turnos.tu-dominio.com

# Texto largo y aleatorio para firmar sesiones
SESSION_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# true cuando la app se sirve por HTTPS (EasyPanel con Let's Encrypt)
COOKIE_SECURE=true

# Videollamada. Por defecto Jitsi público. Podés apuntar a tu Jitsi propio.
JITSI_BASE_URL=https://meet.jit.si

# Cuenta de administrador: se crea sola la primera vez que arranca la app
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambiar-por-una-clave-fuerte

# Email (opcional). Si SMTP_HOST está vacío, los mails no se envían y solo se registran en logs.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=turnos@tu-dominio.com
SMTP_PASS=
MAIL_FROM="Turnos Veterinarios <turnos@tu-dominio.com>"

# Zona horaria de los horarios
TZ=America/Argentina/Buenos_Aires
